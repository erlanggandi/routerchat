# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=8169498884:AAFiz1INUoxJ5CVNPbCjpV7BhwofuPLMD1g
# Whitelist User IDs (ID Telegram admin dipisahkan koma, misal: 123456789,987654321)
ALLOWED_TELEGRAM_USER_IDS=-5540322388

# AI Provider Configuration (OpenAI-Compatible)
# Contoh Provider:
# - OpenAI: AI_BASE_URL=https://api.openai.com/v1, AI_MODEL=gpt-4o-mini
# - Groq: AI_BASE_URL=https://api.groq.com/openai/v1, AI_MODEL=llama-3.1-70b-versatile
# - DeepSeek: AI_BASE_URL=https://api.deepseek.com/v1, AI_MODEL=deepseek-chat
# - Ollama: AI_BASE_URL=http://localhost:11434/v1, AI_MODEL=llama3
# - OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1, AI_MODEL=openai/gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_or_compatible_api_key_here
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./data/mikrotik_bot.db

# Security & Encryption Key (32-url-safe-base64-encoded bytes atau sembarang string yang akan diturunkan)
SECRET_KEY=change_this_to_a_secure_random_key_min_32_chars

# Application Settings
PORT=3010
LOG_LEVEL=INFO
APPROVAL_TIMEOUT_MINUTES=5
METRICS_RETENTION_DAYS=30
